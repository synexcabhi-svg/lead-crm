# ------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# PostgreSQL connection (Prisma).
#  - DATABASE_URL: the connection the running app uses. On Neon use the POOLED
#    string (host contains "-pooler").
#  - DIRECT_URL: an unpooled connection, used only for migrations. On Neon use
#    the string WITHOUT "-pooler". Locally just set it equal to DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_crm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lead_crm?schema=public"

# Secret used to sign auth JWTs. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used for links / CORS)
APP_URL="http://localhost:3000"

# Comma-separated list of origins allowed to call the PUBLIC lead endpoint
# (your marketing site domains). Use "*" only for local dev.
CORS_ORIGIN="http://localhost:3000"

# Origins allowed to invoke Next.js Server Actions (host:port, comma-separated)
SERVER_ACTION_ORIGINS="localhost:3000"

# ---- Lead duplicate handling -------------------------------------
# allow  = always create (no dedupe)
# flag   = create the lead but mark it isDuplicate + link to the original  (default)
# reject = refuse the request with HTTP 409
# update = merge new non-empty fields into the existing lead, do not create a new row
DUPLICATE_STRATEGY="flag"
# Which fields identify a duplicate (comma-separated: email, phone)
DUPLICATE_MATCH_FIELDS="email,phone"

# ---- Public form protection ------------------------------------
# Max submissions per IP inside the rolling window
PUBLIC_RATE_LIMIT="5"
PUBLIC_RATE_WINDOW_MS="600000"
# Require the consent checkbox to be ticked on the public form
REQUIRE_CONSENT="false"

# ---- Dashboard realtime fallback ------------------------------
# How often the dashboard refetches when the SSE stream is unavailable (ms)
NEXT_PUBLIC_DASHBOARD_POLL_MS="30000"

# ---- Public form: IP-based location pre-fill -----------------
# Looks up the visitor's approximate city/state/country from their IP and
# pre-fills the public form (fields stay editable). No API key with the
# default provider (ipwho.is). Set GEOIP_ENABLED=false to turn it off.
GEOIP_ENABLED="true"
GEOIP_PROVIDER_URL="https://ipwho.is/{ip}"
GEOIP_TIMEOUT_MS="2500"

# ---- Email notifications (technical team assignment) ----------
# console = print the email to the server console (default, no setup needed)
# smtp    = actually send via the SMTP settings below
# off     = disable notifications
MAIL_TRANSPORT="console"
MAIL_FROM="Lead CRM <no-reply@leadcrm.local>"
# Only needed when MAIL_TRANSPORT=smtp:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
